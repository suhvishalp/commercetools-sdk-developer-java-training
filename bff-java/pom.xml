<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.13</version>
        <relativePath/>
    </parent>

    <groupId>com.lifestylehomecorp</groupId>
    <artifactId>training-bff</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>LHC Training BFF</name>
    <description>Modular Spring Boot BFF for the commercetools B2C Dev course</description>

    <!--
      Domain-first Maven multi-module reactor.
      - platform  : shared kernel (ProjectApiRoot bean, config, error advice). No controllers.
      - project   : fully-worked reference vertical slice (GET /api/project) through all layers.
      - catalog   : domain module with api/application/domain pre-wired; ONLY infrastructure stubbed (501).
      - product-discovery, cart, customer, order : further domain modules (S3–S6), same shape as catalog.
      - training  : course task/progress tracking (participants rarely touch).
      - app       : aggregator that assembles every module and runs the full BFF on :8081.
      Every domain module depends on `platform` ONLY, never on each other or on `app`.
    -->
    <modules>
        <module>platform</module>
        <module>01-project</module>
        <module>02-catalog</module>
        <module>03-product-discovery</module>
        <module>04-cart</module>
        <module>05-customer</module>
        <module>06-order</module>
        <module>07-extensibility</module>
        <module>training</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Pin the commercetools Java SDK. One property drives both the models jar
             (commercetools-sdk-java-api) and the OkHttp client (commercetools-okhttp-client3),
             so it must be a version where BOTH publish. The models jar has run ahead (20.x),
             but commercetools-okhttp-client3 tops out at 19.11.0 — hence 19.11.0, the highest
             stable release covering both. 19.x is also the first line to carry Recurring Orders
             (LineItem recurrenceInfo) and InventoryMode.RESERVE_ON_CART, both needed in S4.
             Confirm newer releases via the commercetools-knowledge MCP before bumping. -->
        <commercetools.version>19.11.0</commercetools.version>
        <spring-dotenv.version>4.0.0</spring-dotenv.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <springdoc.version>2.8.17</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- MapStruct — used in ONE module (project, api layer) as the reference for generated mappers.
                 Every other mapper in the course is hand-written on purpose: the SDK → domain mapping is the
                 boundary participants learn to see. -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <!-- commercetools typed API + OkHttp3 HTTP client.
                 We use commercetools-okhttp-client3 (NOT the default commercetools-http-client,
                 which bundles OkHttp4) to avoid an OkHttp version clash on the Spring Boot classpath. -->
            <dependency>
                <groupId>com.commercetools.sdk</groupId>
                <artifactId>commercetools-sdk-java-api</artifactId>
                <version>${commercetools.version}</version>
            </dependency>
            <dependency>
                <groupId>com.commercetools.sdk</groupId>
                <artifactId>commercetools-okhttp-client3</artifactId>
                <version>${commercetools.version}</version>
            </dependency>
            <!-- Checkout API (Sessions are plain HTTP; Payment Intents / Applications are typed here). -->
            <dependency>
                <groupId>com.commercetools.sdk</groupId>
                <artifactId>commercetools-sdk-java-checkout</artifactId>
                <version>${commercetools.version}</version>
            </dependency>
            <!-- Import API (Session 7): bulk price feed through import.{region}.commercetools.com. -->
            <dependency>
                <groupId>com.commercetools.sdk</groupId>
                <artifactId>commercetools-sdk-java-importapi</artifactId>
                <version>${commercetools.version}</version>
            </dependency>

            <!-- Reads a gitignored .env into the Spring Environment. -->
            <dependency>
                <groupId>me.paulschwarz</groupId>
                <artifactId>spring-dotenv</artifactId>
                <version>${spring-dotenv.version}</version>
            </dependency>

            <!-- Swagger UI at /swagger-ui.html -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>com.lifestylehomecorp</groupId>
                <artifactId>platform</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lifestylehomecorp</groupId>
                <artifactId>project</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lifestylehomecorp</groupId>
                <artifactId>catalog</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lifestylehomecorp</groupId>
                <artifactId>product-discovery</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lifestylehomecorp</groupId>
                <artifactId>cart</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lifestylehomecorp</groupId>
                <artifactId>customer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lifestylehomecorp</groupId>
                <artifactId>order</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lifestylehomecorp</groupId>
                <artifactId>extensibility</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lifestylehomecorp</groupId>
                <artifactId>training</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
