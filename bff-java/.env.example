# commercetools credentials for the Java BFF. Copy to `.env` (gitignored) and fill in.
# spring-dotenv reads `.env` into the Spring Environment at startup. `.env` is for local development only:
# in production the same variables are injected by the platform you deploy to (or read from a secret
# manager), rotated by creating a second client, switching, then deleting the first.
#
# This is the RUNTIME client — the one shopper traffic uses. Give it only the scopes the course's features
# need, growing session by session (the BFF logs what its client holds at startup and warns if it is
# over-privileged or missing a session's scopes — platform ScopeAudit):
#   S1-S3  view_products view_categories view_stores view_project_settings view_published_products
#   S4     manage_orders view_shipping_methods view_discount_codes view_cart_discounts manage_shopping_lists
#   S5     manage_customers view_customer_groups
#   S6     manage_payments manage_sessions manage_checkout_payment_intents view_states
#   S7     manage_types manage_key_value_documents view_messages manage_extensions manage_subscriptions
#          manage_import_containers manage_products
# NOT manage_project and NOT manage_api_clients: seeders and setup scripts use a separate TOOLING client
# (manage_project) that lives in their own environment file and is never loaded by the BFF.
#
# The browser never sees any of this: it holds one opaque session cookie (lhc_session, HttpOnly,
# SameSite=Lax). Set SESSION_COOKIE_SECURE=true when the BFF is served over HTTPS.

CTP_PROJECT_KEY=your-project-key
CTP_CLIENT_ID=your-client-id
CTP_CLIENT_SECRET=your-client-secret

# Region endpoints (example: europe-west1 GCP). CTP_AUTH_URL is the auth host;
# the app appends /oauth/token itself.
CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
CTP_API_URL=https://api.europe-west1.gcp.commercetools.com

# Optional: in-store key for store-scoped endpoints (leave blank if unused).
CTP_STORE_KEY=

# Training progress tracking.
# Your participant identity is derived AUTOMATICALLY from your API client's NAME — so name your API
# client like "firstname_lastname_api" when you create it. Reading the name needs the
# `manage_api_clients` scope — training plumbing only, NOT a scope a real BFF should hold; without it the
# id falls back to your clientId and PARTICIPANT_NAME (below) is used as the display name.
PARTICIPANT_NAME=Your Name
# Progress store: "ct" (commercetools Custom Object, default) or "memory" (local, no persistence).
TRAINING_PROGRESS_STORE=ct

# Session 6 — commercetools Checkout (Payment Only).
# `demo-commercetools-checkout-taxes` ships with a new project already in PaymentOnly mode, which is
# exactly what Session 6 needs — so the course configures that one rather than creating its own. The
# seeder sets its payment return URL, origins and countries; the trainer attaches the sample payment
# connector and switches on the automated reversal. The API client needs manage_sessions +
# manage_checkout_payment_intents.
CTP_CHECKOUT_APPLICATION_KEY=demo-commercetools-checkout-taxes

# Session 7 — extensibility.
# Import API host (7.8). Leave blank to derive it from CTP_API_URL's region (import.{region}.commercetools.com).
CTP_IMPORT_API_URL=
# API Extensions (7.6 / 7.7): the platform must be able to reach THIS BFF over the public internet.
# Start a tunnel — `cloudflared tunnel --url http://localhost:8081` (no account needed) — and paste its
# https://….trycloudflare.com URL here. Pick any secret; the platform echoes it back in the Authorization
# header of every Extension call and the BFF refuses calls without it.
#
# If the URL answers 530 from outside, your network is blocking QUIC (UDP 7844) — common on corporate
# and hotel Wi-Fi. cloudflared says so in its own start-up precheck ("UDP Connectivity … status=fail,
# suggested_protocol=http2"). Re-run it as:  cloudflared tunnel --protocol http2 --url http://localhost:8081
#
# The hostname is new every time a quick tunnel restarts — update this value and re-run 7.6, which
# re-points the existing Extension rather than creating a second one.
EXTENSION_PUBLIC_URL=
EXTENSION_SECRET=change-me
# Extension time budget in ms (default 2000, platform max 10000).
EXTENSION_TIMEOUT_MS=2000
# The consumer (7.4) transitions orders through the BFF's own HTTP API. Default: this BFF on :8081.
BFF_BASE_URL=http://localhost:8081
# Scopes the API client needs for Session 7: manage_types · manage_key_value_documents · view_messages ·
# manage_extensions · manage_import_containers (+ manage_products). An admin client (manage_project) passes,
# but the startup scope audit flags it: a leaked runtime secret should not be able to administer the project.
